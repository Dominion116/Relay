{
  "name": "relay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node init && node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "build": "node init && tsc && vite build && node scripts/build-api.js",
    "preview": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js preview",
    "mcp": "node --env-file-if-exists=.env --import tsx src/mcp/server.ts",
    "demo:mcp": "node --env-file-if-exists=.env --import tsx scripts/demo-mcp.ts",
    "demo:sdk": "node --env-file-if-exists=.env --import tsx scripts/demo-sdk.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/setup.ts --test --test-concurrency=2 tests/*.test.ts",
    "test:api": "node --import ./tests/setup.ts --test tests/built-api/*.test.mjs",
    "test:browser": "playwright test"
  },
  "overrides": {
    "@rainbow-me/rainbowkit": {
      "@vanilla-extract/css": "1.21.3"
    },
    "ws@^8": "8.21.0",
    "abitype@>=1.0.8 <=1.2.3": "1.2.3",
    "uuid@>=8.0.0 <=11.1.1": "11.1.1",
    "zod": "4.6.7",
    "decode-uri-component": "file:./patches/decode-uri-component"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.106.0",
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^14.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^2.5.4",
    "viem": "^2.57.16",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "8.3.6"
  }
}
