# ==============================================================================
# RELAY PROTOCOL ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# NOTE: ALL VARIABLES ARE OPTIONAL.
# Relay works 100% out-of-the-box with live public endpoints and an auto-generated
# ephemeral agent wallet without creating or setting any .env file.
# 
# Copy this file to .env to customize settings:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MERCHANT / RECEIVER TREASURY SETTINGS
# ------------------------------------------------------------------------------
# The Base wallet address that receives incoming micro-USDC payments for x402 requests.
# Default: 0x420f9F9deA7fA318eA8996C8aA00ad9738D98072
RELAY_TREASURY_ADDRESS=0x420f9F9deA7fA318eA8996C8aA00ad9738D98072

# ------------------------------------------------------------------------------
# 2. AUTONOMOUS AGENT / MCP RUNTIME SIGNING KEY (OPTIONAL)
# ------------------------------------------------------------------------------
# If you run the Model Context Protocol (MCP) server (`npm run mcp`) or backend
# agents that autonomously sign x402 payments, you can provide an on-chain funded
# Base private key (64 hex characters starting with 0x).
#
# If omitted: Relay generates a persistent ephemeral session keypair automatically.
# AGENT_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 3. BASE NETWORK RPC PROVIDER (OPTIONAL)
# ------------------------------------------------------------------------------
# Custom JSON-RPC endpoint for Base Layer 2.
# Default: https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org

# ------------------------------------------------------------------------------
# 4. PROVIDER RATE LIMIT BOOSTS (OPTIONAL)
# ------------------------------------------------------------------------------
# CoinGecko Demo or Pro API Key (increases rate limits beyond the public tier):
# COINGECKO_API_KEY=

# OpenAlex Polite Pool Email (increases free academic rate limit to 100 req/sec):
# OPENALEX_EMAIL=agent@relay.network

# ------------------------------------------------------------------------------
# 5. GATEWAY URL (CLIENT-SIDE VITE)
# ------------------------------------------------------------------------------
# Custom gateway base URL if hosting the x402 gateway on a separate domain.
# Default: auto-detects current host (http://localhost:5173 or current origin)
# VITE_GATEWAY_URL=https://relayx402.vercel.app
