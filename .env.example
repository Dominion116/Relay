# Relay configuration. Never commit a real .env or place private keys in VITE_*.
# Node 24 CLI scripts load .env when present; Vercel uses its environment settings.
# Discovery remains free. Paid requests fail closed without a configured facilitator.

# Gateway: only Base mainnet and Base Sepolia are supported.
RELAY_NETWORK=base
RELAY_TREASURY_ADDRESS=0x420f9F9deA7fA318eA8996C8aA00ad9738D98072
# A separate transaction-submitting account must hold ETH for gas on RELAY_NETWORK.
# RELAY_FACILITATOR_KEY=
# Optional RPC override; otherwise the matching network's public RPC is used.
# BASE_RPC_URL=
RELAY_SETTLEMENT_TIMEOUT_MS=15000
# Optional canonical public origin; otherwise the HTTP request origin is used.
# GATEWAY_ORIGIN=https://relayx402.vercel.app

# Browser build settings must match the gateway network and treasury.
# These are PUBLIC values, never signing secrets.
VITE_BASE_NETWORK=base
VITE_RELAY_TREASURY_ADDRESS=0x420f9F9deA7fA318eA8996C8aA00ad9738D98072
# Empty/unset uses the current browser origin.
# VITE_GATEWAY_URL=https://relayx402.vercel.app
# Without a personal WalletConnect project ID, only injected browser wallets appear.
# VITE_WALLETCONNECT_PROJECT_ID=
# Optional PUBLIC browser RPC endpoint; do not embed a private RPC credential here.
# VITE_BASE_RPC_URL=

# MCP/SDK payer: no generated-key fallback, and no payments until budgets are set.
# AGENT_PRIVATE_KEY=
BASE_NETWORK=base
# MCP gateway URL fallback when GATEWAY_ORIGIN is unset.
# RELAY_GATEWAY_URL=https://relayx402.vercel.app
# Explicit opt-in is required. All catalog calls currently cost at most 0.12 USDC.
MAX_PAYMENT_USDC=0
MAX_DAILY_BUDGET_USDC=0
# Optional absolute path; default is ~/.relay/mcp-budget.json.
# Keep this durable and shared by MCP processes using the same payer wallet.
# RELAY_BUDGET_FILE=

# Optional public-provider credentials. Never expose these as VITE_* variables.
# COINGECKO_API_KEY=
# OPENALEX_EMAIL=
